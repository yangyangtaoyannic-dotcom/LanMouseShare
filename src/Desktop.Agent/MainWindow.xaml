<Window x:Class="LanMouseShare.Agent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="&#x5C40;&#x57DF;&#x7F51;&#x952E;&#x9F20;&#x5171;&#x4EAB;" Height="680" Width="880" MinHeight="560" MinWidth="760"
        AllowDrop="True" Drop="OnDropFiles"
        Icon="/Resources/app.ico"
        Background="#F5F7FA">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#D7DCE5" BorderThickness="1" CornerRadius="6" Padding="14">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="&#x5C40;&#x57DF;&#x7F51;&#x952E;&#x9F20;&#x5171;&#x4EAB;" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Text="LanMouseShare 0.2.0-beta-fix24" Foreground="#667085" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="&#x5237;&#x65B0;" Width="72" Click="OnRefreshClicked" />
                    <Button x:Name="PauseButton" Content="&#x6682;&#x505C;" Width="84" Click="OnPauseClicked" />
                    <Button Content="&#x505C;&#x6B62;&#x63A7;&#x5236;" Width="96" Click="OnStopControlClicked" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="StatusText" Text="&#x670D;&#x52A1;&#x672A;&#x8FDE;&#x63A5;" HorizontalAlignment="Right" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="ControlTargetText" Text="&#x5F53;&#x524D;&#x63A7;&#x5236;&#xFF1A;&#x672C;&#x673A;" HorizontalAlignment="Right" Foreground="#667085" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,14,0,14"
                      AllowDrop="True" Drop="OnDropFiles" DragOver="OnWindowDragOver">
            <Grid AllowDrop="True" Drop="OnDropFiles" DragOver="OnWindowDragOver">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="1.25*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <Border Background="#FFFFFF" BorderBrush="#D7DCE5" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="&#x8FDE;&#x63A5;&#x72B6;&#x6001;" FontSize="16" FontWeight="SemiBold" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="82" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="&#x672C;&#x673A;" Foreground="#667085" />
                                <TextBlock x:Name="LocalNameText" Grid.Column="1" FontWeight="SemiBold" />
                                <TextBlock Text="&#x8BBE;&#x5907;&#x20;&#x49;&#x44;" Grid.Row="1" Foreground="#667085" />
                                <TextBlock x:Name="LocalIdText" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" />
                                <TextBlock Text="&#x5BF9;&#x7AEF;" Grid.Row="2" Foreground="#667085" />
                                <TextBlock x:Name="PeerNameText" Grid.Row="2" Grid.Column="1" FontWeight="SemiBold" />
                                <TextBlock Text="&#x5BF9;&#x7AEF;&#x20;&#x49;&#x50;" Grid.Row="3" Foreground="#667085" />
                                <TextBlock x:Name="PeerAddressText" Grid.Row="3" Grid.Column="1" />
                                <TextBlock Text="&#x914D;&#x5BF9;&#x72B6;&#x6001;" Grid.Row="4" Foreground="#667085" />
                                <TextBlock x:Name="TrustStateText" Grid.Row="4" Grid.Column="1" FontWeight="SemiBold" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="#FFFFFF" BorderBrush="#D7DCE5" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="&#x914D;&#x5BF9;" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="&#x914D;&#x5BF9;&#x7801;" Foreground="#667085" Margin="0,12,0,4" />
                            <DockPanel>
                                <TextBox x:Name="PairingCodeBox" Width="116" DockPanel.Dock="Left" MaxLength="6" />
                                <Button Content="&#x53D1;&#x8D77;" Width="72" Margin="8,0,0,0" Click="OnPairClicked" />
                                <Button Content="&#x540C;&#x610F;" Width="72" Margin="8,0,0,0" Click="OnApproveClicked" />
                            </DockPanel>
                            <TextBlock Text="&#x624B;&#x52A8;&#x8F93;&#x5165;&#x5BF9;&#x7AEF;&#x20;&#x49;&#x50;" Foreground="#667085" Margin="0,12,0,4" />
                            <DockPanel>
                                <TextBox x:Name="ManualIpBox" Width="150" DockPanel.Dock="Left" />
                                <Button Content="&#x4F7F;&#x7528;&#x20;&#x49;&#x50;" Width="86" Margin="8,0,0,0" Click="OnUseManualIpClicked" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="#FFFFFF" BorderBrush="#D7DCE5" BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <TextBlock Text="&#x6587;&#x4EF6;&#x4F20;&#x8F93;" FontSize="16" FontWeight="SemiBold" />
                            <Border BorderBrush="#AAB3C2" BorderThickness="1" CornerRadius="6" Margin="0,12,0,12" Padding="16" Background="#FAFBFC"
                                    AllowDrop="True" Drop="OnDropFiles" DragOver="OnWindowDragOver">
                                <TextBlock Text="&#x628A;&#x666E;&#x901A;&#x6587;&#x4EF6;&#x62D6;&#x5230;&#x6B64;&#x7A97;&#x53E3;&#x53D1;&#x9001;&#x5230;&#x5BF9;&#x7AEF;" HorizontalAlignment="Center" Foreground="#555" />
                            </Border>
                            <TextBlock x:Name="TransferStatusText" Text="" Foreground="#667085" Margin="0,0,0,6" TextWrapping="Wrap" />
                            <ProgressBar x:Name="TransferProgress" Height="8" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,10" />
                            <TextBlock x:Name="TransferDirText" Text="" Foreground="#667085" Margin="0,0,0,6" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="&#x66F4;&#x6539;&#x63A5;&#x6536;&#x76EE;&#x5F55;&#x2026;" Width="124" Click="OnChangeTransferDirClicked" />
                                <Button Content="&#x6062;&#x590D;&#x9ED8;&#x8BA4;" Width="88" Margin="8,0,0,0" Click="OnResetTransferDirClicked" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="&#x53D1;&#x9001;&#x6587;&#x4EF6;&#x2026;" Width="104" Click="OnSendFilesClicked" />
                                <Button Content="&#x6253;&#x5F00;&#x63A5;&#x6536;&#x6587;&#x4EF6;&#x5939;" Width="128" Margin="8,0,0,0" Click="OnOpenTransferFolderClicked" />
                                <Button Content="&#x53D6;&#x6D88;&#x4F20;&#x8F93;" Width="88" Margin="8,0,0,0" Click="OnCancelTransfersClicked" />
                                <Button Content="&#x6253;&#x5F00;&#x65E5;&#x5FD7;" Width="88" Margin="8,0,0,0" Click="OnOpenLogsClicked" />
                                <Button Content="&#x5378;&#x8F7D;" Width="72" Margin="8,0,0,0" Click="OnUninstallClicked" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Border Background="#FFFFFF" BorderBrush="#D7DCE5" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="&#x5C4F;&#x5E55;&#x4F4D;&#x7F6E;" FontSize="16" FontWeight="SemiBold" DockPanel.Dock="Left" />
                                <TextBlock x:Name="LayoutText" HorizontalAlignment="Right" />
                            </DockPanel>
                            <UniformGrid Rows="3" Columns="3" Margin="0,12,0,0" Height="190">
                                <Border />
                                <Button Content="&#x5BF9;&#x7AEF;&#x5728;&#x4E0A;" Tag="Up" Click="OnDirectionClicked" />
                                <Border />
                                <Button Content="&#x5BF9;&#x7AEF;&#x5728;&#x5DE6;" Tag="Left" Click="OnDirectionClicked" />
                                <Border BorderBrush="#2563EB" BorderThickness="2" CornerRadius="6" Margin="8" Padding="8" Background="#EFF6FF">
                                    <TextBlock Text="&#x672C;&#x673A;" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                                </Border>
                                <Button Content="&#x5BF9;&#x7AEF;&#x5728;&#x53F3;" Tag="Right" Click="OnDirectionClicked" />
                                <Border />
                                <Button Content="&#x5BF9;&#x7AEF;&#x5728;&#x4E0B;" Tag="Down" Click="OnDirectionClicked" />
                                <Border />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Background="#FFFFFF" BorderBrush="#D7DCE5" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="&#x8F93;&#x5165;&#x8BBE;&#x7F6E;" FontSize="16" FontWeight="SemiBold" DockPanel.Dock="Left" />
                                <TextBlock x:Name="CurrentRateText" HorizontalAlignment="Right" FontWeight="SemiBold" />
                            </DockPanel>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="38" />
                                    <RowDefinition Height="38" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="&#x9F20;&#x6807;&#x901F;&#x5EA6;" Foreground="#667085" />
                                <Slider x:Name="MouseSpeedSlider" Grid.Column="1" Minimum="0.4" Maximum="2.5" Value="1.0" TickFrequency="0.1"
                                        IsSnapToTickEnabled="False" ValueChanged="OnMouseSpeedChanged" />
                                <TextBlock x:Name="MouseSpeedText" Grid.Column="2" Text="1.00x" HorizontalAlignment="Right" />
                                <TextBlock Text="&#x5237;&#x65B0;&#x7387;" Grid.Row="1" Foreground="#667085" />
                                <ComboBox x:Name="MouseRateBox" Grid.Row="1" Grid.Column="1" Width="120" HorizontalAlignment="Left" SelectionChanged="OnMouseRateChanged">
                                    <ComboBoxItem Content="125Hz" />
                                    <ComboBoxItem Content="160Hz" />
                                    <ComboBoxItem Content="200Hz" IsSelected="True" />
                                    <ComboBoxItem Content="250Hz" />
                                </ComboBox>
                                <TextBlock x:Name="MouseRateText" Grid.Row="1" Grid.Column="2" Text="200Hz" HorizontalAlignment="Right" />
                            </Grid>
                            <CheckBox x:Name="ClipboardEnabledBox" Content="&#x540C;&#x6B65;&#x6587;&#x5B57;&#x548C;&#x56FE;&#x7247;&#x526A;&#x8D34;&#x677F;" IsChecked="True" Checked="OnSettingsChanged" Unchecked="OnSettingsChanged" />
                            <CheckBox x:Name="ScreenEntryRippleBox" Content="&#x8DE8;&#x5C4F;&#x540E;&#x9AD8;&#x4EAE;&#x9F20;&#x6807;&#x843D;&#x70B9;" IsChecked="True" Checked="OnSettingsChanged" Unchecked="OnSettingsChanged" />
                            <CheckBox x:Name="BlockCornersBox" Content="&#x8DE8;&#x5C4F;&#x8FB9;&#x89D2;&#x963B;&#x6321;" Checked="OnSettingsChanged" Unchecked="OnSettingsChanged" />
                        </StackPanel>
                    </Border>

                    <Border Background="#FFFFFF" BorderBrush="#D7DCE5" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="&#x5FEB;&#x6377;&#x952E;" FontSize="16" FontWeight="SemiBold" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="&#x6682;&#x505C;&#x2F;&#x6062;&#x590D;" Foreground="#667085" />
                                <TextBox x:Name="PauseHotkeyBox" Grid.Column="1" PreviewKeyDown="OnHotkeyPreviewKeyDown" LostFocus="OnHotkeyLostFocus" />
                                <TextBlock Text="&#x505C;&#x6B62;&#x63A7;&#x5236;" Grid.Row="1" Foreground="#667085" />
                                <TextBox x:Name="StopHotkeyBox" Grid.Row="1" Grid.Column="1" PreviewKeyDown="OnHotkeyPreviewKeyDown" LostFocus="OnHotkeyLostFocus" />
                                <TextBlock Text="&#x5173;&#x95ED;&#x7A0B;&#x5E8F;" Grid.Row="2" Foreground="#667085" />
                                <TextBox x:Name="ExitHotkeyBox" Grid.Row="2" Grid.Column="1" PreviewKeyDown="OnHotkeyPreviewKeyDown" LostFocus="OnHotkeyLostFocus" />
                            </Grid>
                        </StackPanel>
                    </Border>

                                        <Border Background="#FFFFFF" BorderBrush="#D7DCE5" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="&#x8C03;&#x8BD5;&#x65E5;&#x5FD7;" FontSize="16" FontWeight="SemiBold" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="&#x8FD0;&#x884C;&#x89D2;&#x8272;" Foreground="#667085" />
                                <ComboBox x:Name="ShareRoleBox" Grid.Column="1" Width="186" HorizontalAlignment="Left" SelectionChanged="OnShareRoleChanged">
                                    <ComboBoxItem Content="&#x4E3B;&#x63A7;&#x7AEF;&#xFF08;&#x6C47;&#x603B;&#x5176;&#x4ED6;&#x7535;&#x8111;&#x65E5;&#x5FD7;&#xFF09;" Tag="Controller" />
                                    <ComboBoxItem Content="&#x88AB;&#x63A7;&#x7AEF;&#xFF08;&#x65E5;&#x5FD7;&#x63A8;&#x9001;&#x7ED9;&#x4E3B;&#x63A7;&#x7AEF;&#xFF09;" Tag="Agent" />
                                </ComboBox>
                                <TextBlock Text="&#x4E3B;&#x63A7;&#x7AEF;&#x5730;&#x5740;" Grid.Row="1" Foreground="#667085" />
                                <TextBox x:Name="ControllerAddressBox" Grid.Row="1" Grid.Column="1" LostFocus="OnLogSettingsLostFocus" />
                                <TextBlock Text="&#x8C03;&#x8BD5;&#x53E3;&#x4EE4;" Grid.Row="2" Foreground="#667085" />
                                <TextBox x:Name="DebugTokenBox" Grid.Row="2" Grid.Column="1" LostFocus="OnLogSettingsLostFocus" />
                                <TextBlock Text="&#x4FDD;&#x7559;&#x5929;&#x6570;" Grid.Row="3" Foreground="#667085" />
                                <TextBox x:Name="LogRetentionBox" Grid.Row="3" Grid.Column="1" Width="80" HorizontalAlignment="Left" LostFocus="OnLogSettingsLostFocus" />
                            </Grid>
                            <CheckBox x:Name="VerboseLoggingBox" Margin="0,4,0,0" Content="&#x8BE6;&#x7EC6;&#x65E5;&#x5FD7;&#xFF08;&#x8BB0;&#x5F55;&#x9AD8;&#x9891;&#x4E8B;&#x4EF6;&#xFF0C;&#x4FBF;&#x4E8E;&#x6392;&#x67E5;&#xFF09;" Checked="OnSettingsChanged" Unchecked="OnSettingsChanged" />
<CheckBox x:Name="LogTransferBox" Margin="0,4,0,0" Content="&#x63A8;&#x9001;&#x65E5;&#x5FD7;&#x5230;&#x4E3B;&#x63A7;&#x7AEF;&#xFF08;&#x5173;&#x95ED;&#x540E;&#x4EC5;&#x4FDD;&#x5B58;&#x5728;&#x672C;&#x673A;&#xFF09;" Checked="OnSettingsChanged" Unchecked="OnSettingsChanged" />
                                                            <TextBlock x:Name="LogStatusText" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#667085" />
                            <TextBlock x:Name="LogPathText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#98A2B3" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="&#x6253;&#x5F00;&#x672C;&#x673A;&#x65E5;&#x5FD7;" Width="120" Click="OnOpenLogsClicked" />
                                <Button Content="&#x6253;&#x5F00;&#x88AB;&#x63A7;&#x7AEF;&#x65E5;&#x5FD7;" Width="130" Margin="8,0,0,0" Click="OnOpenRemoteLogsClicked" />
                                <Button Content="&#x5237;&#x65B0;&#x72B6;&#x6001;" Width="90" Margin="8,0,0,0" Click="OnRefreshClicked" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
<Border Background="#FFFFFF" BorderBrush="#D7DCE5" BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <TextBlock Text="&#x542F;&#x52A8;&#x548C;&#x5173;&#x95ED;" FontSize="16" FontWeight="SemiBold" />
                            <DockPanel Margin="0,10,0,0">
                                <TextBlock Text="&#x5F53;&#x524D;&#x6743;&#x9650;" Foreground="#667085" DockPanel.Dock="Left" />
                                <TextBlock x:Name="PrivilegeStatusText" Text="&#x666E;&#x901A;&#x6743;&#x9650;" HorizontalAlignment="Right" FontWeight="SemiBold" />
                            </DockPanel>
                            <CheckBox x:Name="StartWithWindowsBox" Content="&#x5F00;&#x673A;&#x81EA;&#x542F;&#x52A8;" Checked="OnSettingsChanged" Unchecked="OnSettingsChanged" />
                            <CheckBox x:Name="RunAsAdminDefaultBox" Content="&#x9ED8;&#x8BA4;&#x4EE5;&#x7BA1;&#x7406;&#x5458;&#x6743;&#x9650;&#x8FD0;&#x884C;" Checked="OnSettingsChanged" Unchecked="OnSettingsChanged" />
                            <CheckBox x:Name="MinimizeToTrayBox" Content="&#x5173;&#x95ED;&#x7A97;&#x53E3;&#x65F6;&#x6700;&#x5C0F;&#x5316;&#x5230;&#x6258;&#x76D8;" Checked="OnSettingsChanged" Unchecked="OnSettingsChanged" />
                            <Button x:Name="RestartAsAdminButton" Content="&#x7ACB;&#x5373;&#x91CD;&#x542F;&#x4E3A;&#x7BA1;&#x7406;&#x5458;&#x6A21;&#x5F0F;" Width="168" Margin="0,12,0,0" HorizontalAlignment="Left" Click="OnRestartAsAdminClicked" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <DockPanel Grid.Row="2">
            <TextBlock x:Name="HintText" Text="&#x62D6;&#x5165;&#x666E;&#x901A;&#x6587;&#x4EF6;&#x5373;&#x53EF;&#x53D1;&#x9001;&#xFF1B;&#x6682;&#x505C;&#x540E;&#x952E;&#x9F20;&#x3001;&#x526A;&#x8D34;&#x677F;&#x548C;&#x6587;&#x4EF6;&#x53D1;&#x9001;&#x90FD;&#x4F1A;&#x505C;&#x6B62;&#x3002;" Foreground="#667085" DockPanel.Dock="Left" />
            <TextBlock Text="0.2.0-beta-fix24" HorizontalAlignment="Right" Foreground="#667085" />
        </DockPanel>
    </Grid>
</Window>
